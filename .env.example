# Lore configuration. Copy to .env.local and fill in what you need.
# Only DATABASE_URL and a model backend are required. Run `npm run doctor` any
# time to see what is missing and what to type to fix it.

# ---------------------------------------------------------------------------
# Required: where your drafts live
# ---------------------------------------------------------------------------
# docker compose up -d db   gives you exactly this
DATABASE_URL=postgresql://postgres:lore@localhost:5432/lore

# ---------------------------------------------------------------------------
# Required: something to think with. Pick ONE.
# ---------------------------------------------------------------------------
# A. An agent CLI you already pay for. Nothing to set here: install Claude Code
#    or Codex, sign in once, and Lore finds it on PATH. This is the default.
#
# B. An API key, billed per token. A key takes priority over a CLI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
#
# Force one route when you have both: cli | http
# LORE_PROVIDER=cli

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# On first run Lore prints a one-time link in the terminal that makes you the
# owner, so you can skip all of this until you want a second way in.
AUTH_SECRET=                    # openssl rand -base64 32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Magic-link email. The sender must be a domain YOU control and have verified.
# RESEND_API_KEY=
# LORE_MAIL_FROM=Lore <noreply@yourdomain.com>

# Google sign-in, only if you want it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional features. Everything below degrades gracefully when unset.
# ---------------------------------------------------------------------------

# Talk to Lore from your phone. Get a token from @BotFather.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=      # only for a hosted deploy; local uses long polling

# Read X profiles and timelines. Key from twitterapi.io/dashboard
# TWITTERAPI_IO_KEY=

# Push Lore events into n8n, Zapier, Slack or your own service. See docs/WEBHOOKS.md
# LORE_WEBHOOK_SECRET=          # openssl rand -hex 32

# Voice interviews instead of typing.
# FISH_AUDIO_API_KEY=

# Shared relay. Without your own X, Fish Audio or Groq key, Lore makes those calls
# through a shared relay on limited free credits. Your own keys win.
# LORE_RELAY_URL=               # only if you run your own relay
# LORE_RELAY_KEY=               # `npm run relay:connect` sets this up for you
# LORE_RELAY=off                # opt out of the relay completely

# Scheduled jobs. Required if you want them: the cron endpoints refuse every
# request when this is unset, including their own internal callers.
# CRON_SECRET=                  # openssl rand -hex 32

# The background agent that sends briefs. Off unless this is exactly "true".
# AGENT_ENABLED=false
# AGENT_DAILY_OPS_CAP=20
# AGENT_ACTIVE_START=8
# AGENT_ACTIVE_END=22

# Who gets /admin. Set this to the address you claim the instance with,
# otherwise /admin stays closed to everyone.
# ADMIN_EMAIL=
